# Copy this file to .env.local and fill in the values of YOUR NEW Supabase project
# (Our Little Home uses its own project — it shares nothing with any other site).
# These are PUBLIC values (safe in the browser, protected by Row Level Security).
# NEVER put the Supabase secret / service_role key here.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
# (or the legacy "anon public" key)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key

# Base path for GitHub Pages: /<repo-name>/ for a project site, or / for a user site.
VITE_BASE_PATH=/
